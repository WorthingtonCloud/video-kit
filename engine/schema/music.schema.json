{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "video-kit/music.schema.json",
 "title": "music.json",
 "description": "A project's music directions for vs music (else the profile's).",
 "type": "array",
 "items": {
  "$ref": "#/$defs/direction"
 },
 "$defs": {
  "direction": {
   "type": "object",
   "required": [
    "label",
    "style"
   ],
   "additionalProperties": false,
   "properties": {
    "label": {
     "type": "string"
    },
    "style": {
     "type": "string"
    },
    "negative": {
     "type": "string"
    },
    "won": {
     "type": "string"
    }
   }
  }
 }
}
